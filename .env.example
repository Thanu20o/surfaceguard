# Local-only PostgreSQL password. Replace before using Compose outside a private workstation.
POSTGRES_PASSWORD=local-development-only

# Backend settings (Docker Compose overrides DATABASE_URL for its internal database service).
DATABASE_URL=sqlite:///./surfaceguard.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
REQUEST_TIMEOUT_SECONDS=4
REQUEST_INTERVAL_SECONDS=0.2
CT_MIN_INTERVAL_SECONDS=10
MAX_RESPONSE_BYTES=65536
MAX_HOSTS_PER_SCAN=20
ALLOW_PRIVATE_TARGETS=false